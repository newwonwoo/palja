{
  "name": "saju",
  "version": "1.1.5",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:mobile": "vite --mode mobile --host 0.0.0.0",
    "build:mobile": "vite build --mode mobile --outDir dist-mobile",
    "android:sync": "npm run build:mobile && cap sync android",
    "test": "node --test tests/*.test.mjs",
    "parity:update": "node scripts/update-original-parity-checklist.mjs",
    "parity:check": "node scripts/check-full-feature-scope.mjs && node scripts/update-original-parity-checklist.mjs --check",
    "parity:complete": "npm run parity:check && node scripts/check-full-feature-scope.mjs --require-complete"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "astronomy-engine": "2.1.19",
    "korean-lunar-calendar": "0.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
