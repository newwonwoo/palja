{
  "name": "saju",
  "version": "1.1.5",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build:mobile && vite preview --mode mobile --outDir dist-mobile --host 0.0.0.0 --port 3000 --strictPort",
    "preview:web": "vite preview",
    "dev:mobile": "vite --mode mobile --host 0.0.0.0",
    "build:mobile": "vite build --mode mobile --outDir dist-mobile",
    "android:sync": "npm run build:mobile && cap sync android",
    "test": "node --test tests/*.test.mjs",
    "checklist": "node scripts/update-checklist.mjs",
    "checklist:check": "node scripts/update-checklist.mjs --check",
    "checklist:complete": "node scripts/update-checklist.mjs --check --require-complete",
    "upgrade:verify": "node scripts/verify-upgrade-backups.mjs",
    "progress": "node scripts/update-checklist.mjs --check"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "astronomy-engine": "2.1.19",
    "korean-lunar-calendar": "0.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
